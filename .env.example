SECRET_KEY=change-me-to-a-random-secret-key

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3

AI_ENABLED=False

LLM_PROVIDER=openai

OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.0-flash

GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash,gemini-2.0-flash-lite

GEMINI_QUESTION_MAX_OUTPUT_TOKENS=2048

# Ollama Cloud (https://ollama.com/settings/keys) — model names without -cloud suffix

OLLAMA_API_KEY=

OLLAMA_BASE_URL=https://ollama.com

OLLAMA_MODEL=gpt-oss:120b

OLLAMA_FALLBACK_MODELS=gpt-oss:20b,gpt-oss:120b

# Local Ollama hybrid (signed-in desktop app, cloud offload via -cloud suffix):

# LLM_PROVIDER=ollama

# OLLAMA_BASE_URL=http://localhost:11434

# OLLAMA_MODEL=gpt-oss:120b-cloud

# OLLAMA_API_KEY=

